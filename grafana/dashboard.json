      "targets": [
        {
          "rawSql": "SELECT\n  user_name AS \"User\",\n  username AS \"Username\",\n  total_messages AS \"Messages\",\n  created_at AS \"Created\",\n  updated_at AS \"Updated\",\n  topic_link AS \"Link\"\nFROM topic_stats\nORDER BY updated_at DESC\nLIMIT 50;",
