    {
      "id": 10,
      "title": "New Users per Day",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "uid": "raytun-support", "type": "grafana-postgresql-datasource" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "linear",
            "barAlignment": 0,
            "lineWidth": 1,
            "fillOpacity": 50,
            "gradientMode": "scheme",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": { "type": "linear" },
            "thresholdsStyle": { "mode": "off" }
          },
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }
      },
      "targets": [
        {
          "rawSql": "SELECT\n  DATE_TRUNC('day', TO_TIMESTAMP(created_at, 'YYYY-MM-DD HH24:MI:SS')) AS time,\n  COUNT(*) AS \"New Users\"\nFROM users\nWHERE TO_TIMESTAMP(created_at, 'YYYY-MM-DD HH24:MI:SS') BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY 1\nORDER BY 1;",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Cumulative Users",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "uid": "raytun-support", "type": "grafana-postgresql-datasource" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "scheme",
            "spanNulls": false,
            "showPoints": "never",
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto",
            "scaleDistribution": { "type": "linear" },
            "thresholdsStyle": { "mode": "off" }
          },
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }
      },
      "targets": [
        {
          "rawSql": "SELECT\n  d.time,\n  SUM(COALESCE(u.cnt, 0)) OVER (ORDER BY d.time) AS \"Total Users\"\nFROM (\n  SELECT generate_series(\n    DATE_TRUNC('day', $__timeFrom()::timestamp),\n    DATE_TRUNC('day', $__timeTo()::timestamp),\n    '1 day'::interval\n  ) AS time\n) d\nLEFT JOIN (\n  SELECT\n    DATE_TRUNC('day', TO_TIMESTAMP(created_at, 'YYYY-MM-DD HH24:MI:SS')) AS time,\n    COUNT(*) AS cnt\n  FROM users\n  GROUP BY 1\n) u ON d.time = u.time\nORDER BY 1;",
          "format": "table",
          "refId": "A"
        }
      ]
    },
