        {
          "rawSql": "SELECT\n  DATE_TRUNC('day', TO_TIMESTAMP(timestamp, 'YYYY-MM-DD HH24:MI:SS')) AS time,\n  responder_name AS metric,\n  COUNT(*) AS value\nFROM message_stats\nWHERE TO_TIMESTAMP(timestamp, 'YYYY-MM-DD HH24:MI:SS') BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY 1, 2\nORDER BY 1;",
